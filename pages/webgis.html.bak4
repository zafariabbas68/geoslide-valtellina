<!DOCTYPE HTML>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>WebGIS · GeoSlide Valtellina</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="stylesheet" href="../assets/css/custom-styles.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/@geoman-io/leaflet-geoman-free@2.17.0/dist/leaflet-geoman.css" />

<style>
  #map{
    position:fixed; top:var(--nav-h); left:0; right:0; bottom:0;
    z-index:1;
  }
  .gs-panel{
    position:fixed; top:calc(var(--nav-h) + 20px); left:20px; z-index:1000;
    width:320px; max-height:calc(100vh - var(--nav-h) - 40px);
    overflow-y:auto;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(14px);
    border:1px solid rgba(15,23,42,.06);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:20px;
    font-size:14px;
  }
  .gs-panel h3{
    font-size:.78rem; letter-spacing:.1em; text-transform:uppercase;
    color:var(--c-muted); margin:20px 0 10px; font-weight:600;
  }
  .gs-panel h3:first-child{ margin-top:0; }
  .toggle{
    display:flex; align-items:center; gap:10px;
    padding:8px 10px; border-radius:8px;
    transition:background .15s;
    cursor:pointer;
  }
  .toggle:hover{ background:rgba(37,99,235,.06); }
  .toggle input{ accent-color:var(--c-primary); }
  .toggle label{ margin:0; font-size:.9rem; color:var(--c-text-soft); cursor:pointer; }
  .swatch{
    display:inline-block; width:14px; height:14px;
    border-radius:4px; margin-right:8px; vertical-align:middle;
  }
  .legend-row{
    display:flex; align-items:center;
    font-size:.85rem; color:var(--c-text-soft);
    padding:4px 0;
  }
  .info-box{
    background:linear-gradient(135deg,rgba(37,99,235,.05),rgba(14,165,233,.05));
    border:1px solid rgba(37,99,235,.12);
    border-radius:10px; padding:10px 12px;
    font-size:.82rem; color:var(--c-text-soft); line-height:1.55;
    margin-top:8px;
  }
  .info-box b{ color:var(--c-text); }
  .badge{
    display:inline-block; padding:2px 8px; border-radius:6px;
    color:#fff; font-size:.72rem; font-weight:600;
    letter-spacing:.02em;
  }
  .b-low   { background:#16a34a; }
  .b-mod   { background:#eab308; }
  .b-high  { background:#f97316; }
  .b-vhigh { background:#dc2626; }
  .btn-clear{
    width:100%; padding:9px; margin-top:10px;
    border:1px solid var(--c-border);
    background:#fff; border-radius:8px;
    font-size:.82rem; font-weight:500;
    color:var(--c-text-soft); cursor:pointer;
    transition:all .15s;
  }
  .btn-clear:hover{
    border-color:var(--c-primary);
    color:var(--c-primary);
    background:rgba(37,99,235,.04);
  }

  /* Override Leaflet default look */
  .leaflet-control-layers{
    background:rgba(255,255,255,.95) !important;
    backdrop-filter:blur(10px);
    border-radius:10px !important;
    border:1px solid var(--c-border) !important;
    box-shadow:var(--shadow-sm) !important;
    font-family:'Inter',sans-serif !important;
  }
  .leaflet-bar a{
    background:rgba(255,255,255,.95) !important;
    color:var(--c-text) !important;
    border-radius:8px !important;
    border:1px solid var(--c-border) !important;
  }

  /* Responsive */
  @media(max-width:820px){
    .gs-panel{
      position:fixed; top:auto; bottom:0; left:0; right:0;
      width:100%; max-height:45vh;
      border-radius:var(--radius) var(--radius) 0 0;
    }
  }
</style>
</head>
<body>

<nav class="gs-nav solid" id="gs-nav">
  <a href="../index.html" class="brand">
    <span class="logo">G</span>
    <span>GeoSlide <span style="color:var(--c-accent)">Valtellina</span></span>
  </a>
  <button class="burger" id="burger" aria-label="Menu">☰</button>
  <ul id="nav-links">
    <li><a href="../index.html">Home</a></li>
    <li><a href="methodology.html">Methodology</a></li>
    <li class="active"><a href="webgis.html">WebGIS</a></li>
    <li><a href="results.html">Results</a></li>
  </ul>
</nav>

<div id="map"></div>

<aside class="gs-panel">
  <h3>Layers</h3>
  <div class="toggle"><input type="checkbox" id="lyr-susc" checked><label for="lyr-susc">Susceptibility raster</label></div>
  <div class="toggle"><input type="checkbox" id="lyr-hill"><label for="lyr-hill">Hillshade (DEM)</label></div>
  <h3>Legend</h3>
  <div class="legend-row"><span class="swatch" style="background:#16a34a"></span>Low (0 – 0.25)</div>
  <div class="legend-row"><span class="swatch" style="background:#eab308"></span>Moderate (0.25 – 0.50)</div>
  <div class="legend-row"><span class="swatch" style="background:#f97316"></span>High (0.50 – 0.75)</div>
  <div class="legend-row"><span class="swatch" style="background:#dc2626"></span>Very high (0.75 – 1.0)</div>

  <h3>Study area</h3>
  <div class="info-box">
    <b>Area:</b> 140.79 km²<br>
    <b>Elevation:</b> 943 – 3,414 m<br>
    <b>Resolution:</b> 5 m<br>
    <b>CRS:</b> EPSG:32632 (UTM 32N)
  </div>

  <h3>Click to sample</h3>
  <div class="info-box" id="click-info">Click anywhere on the map to read elevation and susceptibility.</div>

  <h3>Draw ROI</h3>
  <div class="info-box">Use the rectangle tool (top-left) to clip and get statistics.</div>
  <div class="info-box" id="roi-info" style="display:none;"></div>
  <button class="btn-clear" id="clear-roi">Clear ROI</button>
</aside>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/@geoman-io/leaflet-geoman-free@2.17.0/dist/leaflet-geoman.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.9.2/proj4.js"></script>
<script src="https://unpkg.com/georaster@1.6.0/dist/georaster.browser.bundle.min.js"></script>
<script src="https://unpkg.com/geoblaze@0.0.12/dist/geoblaze.web.min.js"></script>

<script>
// Navbar burger (kept solid)
document.getElementById('burger').addEventListener('click', () => {
  document.getElementById('nav-links').classList.toggle('open');
});

// ---------------- Map ----------------
const map = L.map('map', { center:[46.41, 7.10], zoom:12, zoomControl:false });

L.control.zoom({ position:'topright' }).addTo(map);
L.control.scale({ position:'bottomright' }).addTo(map);

const osm  = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
  { attribution:'© OpenStreetMap' }).addTo(map);
const topo = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
  { attribution:'© OpenTopoMap' });
const sat  = L.tileLayer(
  'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
  { attribution:'© Esri' });

L.control.layers({ 'OSM':osm, 'Topo':topo, 'Satellite':sat }, {}, { position:'topright' }).addTo(map);

// Susceptibility + hillshade tiles
const susc = L.tileLayer('../data/tiles/{z}/{x}/{y}.png',
  { opacity:0.78, maxNativeZoom:16, maxZoom:18, attribution:'Susceptibility © GeoSlide Valtellina' })
  .addTo(map);

const hill = L.tileLayer('../data/hillshade/{z}/{x}/{y}.png',
  { opacity:0.55, maxNativeZoom:16, maxZoom:18 });


// Layer toggles
const bind = (id, layer) => {
  document.getElementById(id).addEventListener('change', e => {
    e.target.checked ? layer.addTo(map) : map.removeLayer(layer);
  });
};
bind('lyr-susc', susc);
bind('lyr-hill', hill);

// Click to sample (geoblaze on COG)
let georaster = null;
fetch('../data/susceptibility_cog.tif')
  .then(r => r.ok ? r.arrayBuffer() : null)
  .then(buf => { if (buf) return parseGeoraster(buf); })
  .then(gr => { georaster = gr; })
  .catch(() => {});

const classify = v =>
  isNaN(v)   ? { label:'—',        cls:'' } :
  v < 0.25   ? { label:'Low',      cls:'b-low' } :
  v < 0.50   ? { label:'Moderate', cls:'b-mod' } :
  v < 0.75   ? { label:'High',     cls:'b-high' } :
               { label:'Very high',cls:'b-vhigh' };

map.on('click', async e => {
  const info = document.getElementById('click-info');
  const { lat, lng } = e.latlng;
  info.innerHTML = `Lat <b>${lat.toFixed(5)}</b> · Lon <b>${lng.toFixed(5)}</b><br>`;
  if (!georaster || typeof geoblaze === 'undefined'){
    info.innerHTML += '<i>COG not loaded — add data/susceptibility_cog.tif to enable sampling.</i>';
    return;
  }
  try{
    const v = await geoblaze.identify(georaster, [lng, lat]);
    const val = (v && v[0] != null) ? v[0] : NaN;
    const c = classify(+val);
    info.innerHTML +=
      `Susceptibility: <b>${isNaN(val)?'—':val.toFixed(3)}</b><br>` +
      `Class: <span class="badge ${c.cls}">${c.label}</span>`;
  }catch{ info.innerHTML += '<i>Sampling failed.</i>'; }
});

// Draw ROI
map.pm.addControls({
  position:'topleft',
  drawRectangle:true, drawPolygon:true,
  drawCircleMarker:false, drawMarker:false,
  drawPolyline:false, drawCircle:false,
  editMode:true, dragMode:false,
  cutPolygon:false, removalMode:true
});

map.on('pm:create', async e => {
  const geom = e.layer.toGeoJSON().geometry;
  const roiBox = document.getElementById('roi-info');
  roiBox.style.display = 'block';

  const ring = geom.coordinates[0].map(c => proj4('EPSG:4326','EPSG:32632', c));
  let a = 0;
  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++)
    a += (ring[j][0] + ring[i][0]) * (ring[j][1] - ring[i][1]);
  const area_m2 = Math.abs(a / 2);

  roiBox.innerHTML =
    `<b>ROI area:</b> ${(area_m2/1e6).toFixed(3)} km² (${(area_m2/1e4).toFixed(2)} ha)`;

  if (georaster && typeof geoblaze !== 'undefined'){
    try{
      const stats = await geoblaze.stats(georaster, geom, ['mean','min','max']);
      roiBox.innerHTML +=
        `<br>Mean: <b>${stats[0].mean.toFixed(3)}</b>` +
        `<br>Min ${stats[0].min.toFixed(3)} · Max ${stats[0].max.toFixed(3)}`;
    }catch{ /* ignore */ }
  }
});

document.getElementById('clear-roi').onclick = () => {
  map.eachLayer(l => { if (l.pm && l.pm.getShape){ try{ l.remove(); }catch(_){} }});
  document.getElementById('roi-info').style.display = 'none';
};
</script>
</body>
</html>
